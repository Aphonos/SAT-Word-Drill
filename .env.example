# Copy this file to .env and fill in your key.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant...

# Model used for BOTH the one-time content generation script and the
# live answer-grading endpoint. Check https://docs.claude.com/en/docs/about-claude/models
# for the current Haiku model ID, since these rotate over time.
CLAUDE_MODEL=claude-haiku-4-5

# Local port for the server
PORT=3000
